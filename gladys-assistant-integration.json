{
  "manifest_version": 1,
  "type": "device",
  "name": "GLPI",
  "description": {
    "en": "GLPI tickets: open, late, solved today; new ticket trigger; tickets created from a scene.",
    "fr": "Tickets GLPI : ouverts, en retard, résolus du jour ; déclencheurs, et tickets créés par une scène.",
    "de": "GLPI-Tickets: offen, überfällig, heute gelöst; Auslöser und Tickets aus einer Szene erstellt.",
    "es": "Tickets de GLPI: abiertos, atrasados, resueltos hoy; disparadores y tickets creados por una escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-glpi:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-glpi/main/cover.png",
  "categories": ["services"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your GLPI",
        "fr": "Votre GLPI",
        "de": "Dein GLPI",
        "es": "Su GLPI"
      },
      "description": {
        "en": "GLPI 10 or later, self-hosted or GLPI Network Cloud. In GLPI: turn on the REST API (Setup, General, API), then copy the API token of a user (its preferences). See the documentation.",
        "fr": "GLPI 10 ou plus récent, auto-hébergé ou GLPI Network Cloud. Dans GLPI : activez l'API REST (Configuration, Générale, API), puis copiez le jeton d'API d'un utilisateur (ses préférences). Voir la documentation.",
        "de": "GLPI 10 oder neuer, selbst gehostet oder GLPI Network Cloud. In GLPI: Schalte die REST-API ein (Konfiguration, Allgemein, API) und kopiere das API-Token eines Benutzers (seine Einstellungen). Siehe Dokumentation.",
        "es": "GLPI 10 o posterior, autoalojado o GLPI Network Cloud. En GLPI: active la API REST (Configuración, General, API) y copie el token de API de un usuario (sus preferencias). Consulte la documentación."
      },
      "links": [
        {
          "url": "https://glpi-user-documentation.readthedocs.io/",
          "label": {
            "en": "GLPI documentation",
            "fr": "Documentation de GLPI",
            "de": "GLPI-Dokumentation",
            "es": "Documentación de GLPI"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Address",
        "fr": "Adresse",
        "de": "Adresse",
        "es": "Dirección"
      },
      "description": {
        "en": "Address of GLPI as in the browser, with https:// for HTTPS and the /glpi folder if any.",
        "fr": "Adresse de GLPI comme dans le navigateur, avec https:// pour le HTTPS et le dossier /glpi s'il y en a un.",
        "de": "Adresse von GLPI wie im Browser, mit https:// für HTTPS und dem Ordner /glpi, falls vorhanden.",
        "es": "Dirección de GLPI como en el navegador, con https:// para HTTPS y la carpeta /glpi si la hay."
      },
      "placeholder": {
        "en": "e.g. https://helpdesk.example.org",
        "fr": "ex. https://helpdesk.example.org",
        "de": "z. B. https://helpdesk.example.org",
        "es": "p. ej. https://helpdesk.example.org"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "user_token",
      "type": "secret",
      "label": {
        "en": "User token",
        "fr": "Jeton utilisateur",
        "de": "Benutzer-Token",
        "es": "Token de usuario"
      },
      "description": {
        "en": "The API token of the GLPI user Gladys acts as: in its preferences, API token, Regenerate, then copy.",
        "fr": "Le jeton d'API de l'utilisateur GLPI au nom duquel Gladys agit : dans ses préférences, Jeton d'API, Regénérer, puis copiez-le.",
        "de": "Das API-Token des GLPI-Benutzers, in dessen Namen Gladys handelt: in seinen Einstellungen, API-Token, Neu erzeugen, dann kopieren.",
        "es": "El token de API del usuario de GLPI en cuyo nombre actúa Gladys: en sus preferencias, API token, Regenerar, y cópielo."
      },
      "required": true
    },
    {
      "key": "app_token",
      "type": "secret",
      "label": {
        "en": "Application token",
        "fr": "Jeton d'application",
        "de": "Anwendungs-Token",
        "es": "Token de aplicación"
      },
      "description": {
        "en": "Only if the API client of GLPI has one (Setup, General, API, API clients).",
        "fr": "Seulement si le client d'API de GLPI en a un (Configuration, Générale, API, Clients de l'API).",
        "de": "Nur, wenn der API-Client von GLPI eines hat (Konfiguration, Allgemein, API, API-Clients).",
        "es": "Solo si el cliente de la API de GLPI tiene uno (Configuración, General, API, Clientes de la API)."
      },
      "required": false
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "allow_self_signed",
      "type": "boolean",
      "label": {
        "en": "Accept self-signed certificates",
        "fr": "Accepter les certificats auto-signés",
        "de": "Selbstsignierte Zertifikate akzeptieren",
        "es": "Aceptar certificados autofirmados"
      },
      "description": {
        "en": "For an https:// address whose certificate is self-signed. Tick only for your own server.",
        "fr": "Pour une adresse en https:// dont le certificat est auto-signé. À cocher pour votre propre serveur seulement.",
        "de": "Für eine https://-Adresse mit selbstsigniertem Zertifikat. Nur für deinen eigenen Server aktivieren.",
        "es": "Para una dirección https:// con certificado autofirmado. Márquelo solo para su propio servidor."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often GLPI is read: the counters and the scene triggers follow it.",
        "fr": "Fréquence de lecture de GLPI : les compteurs et les déclencheurs de scène la suivent.",
        "de": "Wie oft GLPI gelesen wird: Zähler und Szenenauslöser folgen ihr.",
        "es": "Con qué frecuencia se lee GLPI: los contadores y los disparadores de escena la siguen."
      },
      "required": false,
      "default": "300",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "120",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "600",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Names given to the features when the device is added, and texts sent to scenes.",
        "fr": "Noms donnés aux fonctionnalités à l'ajout de l'appareil, et textes envoyés aux scènes.",
        "de": "Namen der Funktionen beim Hinzufügen des Geräts und an Szenen gesendete Texte.",
        "es": "Nombres de las funciones al añadir el dispositivo y textos enviados a las escenas."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads GLPI now and reports what it finds.",
        "fr": "Lit GLPI maintenant et indique ce qu'il trouve.",
        "de": "Liest GLPI sofort und meldet, was es findet.",
        "es": "Lee GLPI ahora e indica lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "ticket_created",
      "label": {
        "en": "New GLPI ticket",
        "fr": "Nouveau ticket GLPI",
        "de": "Neues GLPI-Ticket",
        "es": "Nuevo ticket de GLPI"
      },
      "description": {
        "en": "A ticket was opened in GLPI (not those created by Gladys).",
        "fr": "Un ticket a été ouvert dans GLPI (hors ceux créés par Gladys).",
        "de": "Ein Ticket wurde in GLPI eröffnet (außer den von Gladys erstellten).",
        "es": "Se ha abierto un ticket en GLPI (salvo los creados por Gladys)."
      },
      "fields": [
        {
          "key": "urgency",
          "type": "multi_select",
          "label": {
            "en": "Urgency (empty: any)",
            "fr": "Urgence (vide : toutes)",
            "de": "Dringlichkeit (leer: beliebig)",
            "es": "Urgencia (vacío: cualquiera)"
          },
          "options": [
            {
              "value": "1",
              "label": {
                "en": "Very low",
                "fr": "Très basse",
                "de": "Sehr niedrig",
                "es": "Muy baja"
              }
            },
            {
