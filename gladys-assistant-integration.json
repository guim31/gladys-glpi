              "label": {
                "en": "Low",
                "fr": "Basse",
                "de": "Niedrig",
                "es": "Baja"
              }
            },
            {
              "value": "3",
              "label": {
                "en": "Medium",
                "fr": "Moyenne",
                "de": "Mittel",
                "es": "Media"
              }
            },
            {
              "value": "4",
              "label": {
                "en": "High",
                "fr": "Haute",
                "de": "Hoch",
                "es": "Alta"
              }
            },
            {
              "value": "5",
              "label": {
                "en": "Very high",
                "fr": "Très haute",
                "de": "Sehr hoch",
                "es": "Muy alta"
              }
            }
          ]
        },
        {
          "key": "type",
          "type": "select",
          "label": {
            "en": "Type (empty: any)",
            "fr": "Type (vide : tous)",
            "de": "Typ (leer: beliebig)",
            "es": "Tipo (vacío: cualquiera)"
          },
          "options": [
            {
              "value": "1",
              "label": {
